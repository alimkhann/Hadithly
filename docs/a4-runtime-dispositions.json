  "source_review": [
    {
      "surface": "Auth",
      "result": "Static copy uses typed keys or nativeText. Email-code interpolation is repaired. SDK error text is bounded. Inputs remain opaque."
    },
    {
      "surface": "Onboarding",
      "result": "Titles and buttons use typed keys/resources. Authenticity claim templates use the selected UI locale at presentation; existing hadith/collection/unverified decisions are unchanged. Autonyms, source text, attribution, license names and source names stay opaque. A1/A3 content gates remain open."
    },
    {
      "surface": "Today and Library",
      "result": "Greeting, progress, counts, conditionals and action names resolve the UI locale. Dates use locale formatters. Reference/title data and user names stay opaque."
    },
    {
      "surface": "Reader",
      "result": "Loading, navigation/menu cards, icon names, bookmark fallbacks, accessibility markers/grades and report/evidence errors are traced to localized boundaries. Volume/chapter/source/user text stays opaque. The unused ReaderSheetSectionLabel has no runtime caller. Authenticity templates are localized at presentation; the legacy model formatter is not a product UI caller."
    },
    {
      "surface": "Saved",
      "result": "Filters, empty guidance, confirmation/Undo and timestamps retain earlier native evidence. Folder names, notes and preview content remain opaque."
    },
    {
      "surface": "Settings",
      "result": "Root headers/summaries/account fallbacks and destination notices are traced to selected-locale renderers. Autonyms, time strings, cache sizes, names, emails and external price fields remain data. Store/export/account callbacks and fences are unchanged."
    },
    {
      "surface": "Evidence and reports",
      "result": "Own guidance and status use fixed keys. Known error guidance is localized; arbitrary diagnostics use a bounded fallback. Source citations and filenames remain verbatim."
    },
    {
      "surface": "Purchase",
      "result": "Owned labels and failure notices are localized. Store-provided prices and purchase/account state are preserved. Actual store/annual-total acceptance stays open."
    },
    {
      "surface": "Widgets and notifications",
      "result": "Retain previous A4 fifteen-locale dictionaries, plural and backend-notification evidence. Physical scheduling/widget acceptance stays open."
    },
    {
      "surface": "Core UI wrappers and variable text",
      "result": "Typed SwiftUI labels, nativeText helpers, prelocalized values and opaque data cover remaining variable Text arguments. Root/model-backed wrappers and semantic names were reviewed separately from the lexical report."
    }
  ],

# Q1 server-only Convex configuration. Values here are examples, not credentials.
# Install actual values only after the owner's action-time approval.
APP_ATTEST_BUNDLE_ID=com.hadithly.app
APP_ATTEST_TEAM_ID=YOUR_APP_ID_PREFIX
PLAY_INTEGRITY_PACKAGE_NAME=com.hadithly.app
PLAY_INTEGRITY_PROJECT_NUMBER=YOUR_LINKED_PUBLIC_PROJECT_NUMBER
# Comma-separated base64url SHA-256 signing certificate digests, not colon-hex.
PLAY_INTEGRITY_CERTIFICATE_DIGESTS=YOUR_PLAY_SIGNING_CERTIFICATE_DIGEST
# Secret JSON service-account credential authorized only to decode this app's tokens.
PLAY_INTEGRITY_CREDENTIALS=
# This can permit unavailable proof ONLY on festive-cobra-664's exact URL.
# Production ignores true. Invalid/tampered supplied proofs always fail.
AI_ALLOW_UNATTESTED_DEV=false
# Generation budget includes conservative reservations for unknown/abandoned calls.
AI_MONTHLY_BUDGET_USD=10
AI_MONTHLY_ATTEMPT_LIMIT=25000

# Q2 server-only values; install only at the approved action-time deployment.
# RevenueCat v1 subscriber-read key. Existing platform SDK key works for GET.
# No secret with grant/delete access is needed. Never use the webhook secret.
REVENUECAT_REST_API_KEY=
# Exact RevenueCat Apple and Play app IDs, comma-separated. No wildcard.
REVENUECAT_APP_IDS=YOUR_APPLE_REVENUECAT_APP_ID,YOUR_PLAY_REVENUECAT_APP_ID
# Production is the default; SANDBOX is allowed only on dev:festive-cobra-664.
REVENUECAT_ENVIRONMENT=PRODUCTION
# Proposed Google catalog. Read back registered IDs/base plans before installing.
# Keep them distinct from Apple SKUs. Both must bind the sole pro entitlement.
REVENUECAT_PLAY_PRODUCTS=hadithly_pro_monthly:monthly,hadithly_pro_annual:annual
# Dashboard requirements: Keep with original App User ID; Family Sharing off;
# default offering only monthly+annual, both stores and native keys connected.

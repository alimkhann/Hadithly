          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Google orqali kirish brauzerda ochiladi, keyin shu yerga qaytasiz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",

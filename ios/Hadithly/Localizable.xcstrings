    "Pro unlocks 100 AI translations per rolling week. Reading, saved items, and existing translations stay free.": {
      "comment": "A description of the free tier of the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro unlocks 100 AI translations per rolling week. Reading, saved items, and existing translations stay free."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتيح Pro 100 ترجمة بالذكاء الاصطناعي في كل أسبوع متحرك. وتبقى القراءة والعناصر المحفوظة والترجمات الموجودة مجانية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro открывает 100 переводов ИИ в каждую скользящую неделю. Чтение, сохранённые материалы и существующие переводы остаются бесплатными."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro әр жылжымалы аптада 100 AI аудармасын ашады. Оқу, сақталған элементтер және бар аудармалар тегін болып қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro ар бир жылма жумада 100 AI котормосун ачат. Окуу, сакталган элементтер жана бар котормолор акысыз бойдон калат."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro har bir siljiydigan haftada 100 ta SI tarjimasini ochadi. O‘qish, saqlangan narsalar va mavjud tarjimalar bepul qoladi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro, her hareketli haftada 100 AI çevirisinin kilidini açar. Okuma, kayıtlı öğeler ve mevcut çeviriler ücretsiz kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro membuka 100 terjemahan AI setiap minggu bergulir. Membaca, item tersimpan, dan terjemahan yang ada tetap gratis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro ہر مسلسل ہفتے میں 100 AI تراجم کھولتا ہے۔ مطالعہ، محفوظ اشیا اور موجودہ تراجم مفت رہتے ہیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro débloque 100 traductions IA par semaine glissante. La lecture, les éléments enregistrés et les traductions existantes restent gratuits."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro desbloquea 100 traducciones con IA por semana móvil. La lectura, lo guardado y las traducciones existentes siguen siendo gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Pro libera 100 traduções por IA por semana móvel. A leitura, os itens salvos e as traduções existentes continuam gratuitos."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro hufungua tafsiri 100 za AI kila wiki inayosogea. Kusoma, vilivyohifadhiwa na tafsiri zilizopo hubaki bila malipo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro हर लगातार सप्ताह में 100 AI अनुवाद खोलता है। पढ़ना, सहेजी गई चीज़ें और मौजूदा अनुवाद मुफ़्त रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pro প্রতি চলমান সপ্তাহে ১০০টি AI অনুবাদ চালু করে। পড়া, সংরক্ষিত জিনিস ও বিদ্যমান অনুবাদ বিনামূল্যে থাকে।"
          }
        }
      }
    },

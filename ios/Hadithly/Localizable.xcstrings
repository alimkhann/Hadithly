    "You can create an account later — everything you need to start reading works without one.": {
      "comment": "A footer message below the \"Continue\" button in the welcome view, explaining that an account is not required to use the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can create an account later — everything you need to start reading works without one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك إنشاء حساب لاحقًا — يعمل كل ما تحتاجه لبدء القراءة من دونه."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы сможете создать аккаунт позже — всё необходимое для начала чтения работает без него."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аккаунтты кейін жасай аласыз — оқуды бастауға қажеттінің бәрі аккаунтсыз жұмыс істейді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аккаунтту кийин түзсөңүз болот — окууну баштоо үчүн керектүүнүн баары аккаунтсуз иштейт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keyinroq hisob yaratishingiz mumkin — o‘qishni boshlash uchun kerak bo‘lgan hamma narsa hisobsiz ishlaydi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Daha sonra hesap oluşturabilirsiniz — okumaya başlamak için gereken her şey hesap olmadan çalışır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda dapat membuat akun nanti — semua yang diperlukan untuk mulai membaca berfungsi tanpa akun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ اسے سیٹنگز میں کسی بھی وقت بدل سکتے ہیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez créer un compte plus tard — tout le nécessaire pour commencer à lire fonctionne sans compte."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes crear una cuenta después; todo lo necesario para empezar a leer funciona sin una."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode criar uma conta depois — tudo o que precisa para começar a ler funciona sem uma conta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unaweza kuunda akaunti baadaye — kila kitu cha kuanza kusoma hufanya kazi bila akaunti."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप बाद में खाता बना सकते हैं — पढ़ना शुरू करने के लिए ज़रूरी सब कुछ बिना खाते के चलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পরে অ্যাকাউন্ট তৈরি করতে পারেন — পড়া শুরু করার জন্য দরকারি সবকিছু অ্যাকাউন্ট ছাড়াই চলে।"
          }
        }
      }
    },

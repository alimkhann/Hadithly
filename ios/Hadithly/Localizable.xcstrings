    "Today’s hadith is not available yet. Choose a collection below to keep reading." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s hadith is not available yet. Choose a collection below to keep reading."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حديث اليوم غير متاح بعد. اختر مجموعة أدناه لمتابعة القراءة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сегодняшний хадис пока недоступен. Выберите сборник ниже, чтобы продолжить чтение."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бүгінгі хадис әзірге қолжетімсіз. Оқуды жалғастыру үшін төменнен жинақты таңдаңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бүгүнкү хадис азырынча жеткиликсиз. Окууну улантуу үчүн төмөндөн жыйнак тандаңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bugungi hadis hali mavjud emas. O‘qishni davom ettirish uchun quyidan to‘plamni tanlang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bugünün hadisi henüz mevcut değil. Okumaya devam etmek için aşağıdan bir koleksiyon seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadis hari ini belum tersedia. Pilih koleksi di bawah untuk melanjutkan membaca."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آج کی حدیث ابھی دستیاب نہیں ہے۔ پڑھنا جاری رکھنے کے لیے نیچے کوئی مجموعہ منتخب کریں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le hadith du jour n’est pas encore disponible. Choisissez un recueil ci-dessous pour continuer à lire."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El hadiz de hoy aún no está disponible. Elige una colección abajo para seguir leyendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O hadith de hoje ainda não está disponível. Escolha uma coleção abaixo para continuar a leitura."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithi ya leo bado haipatikani. Chagua mkusanyiko hapa chini ili kuendelea kusoma."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आज की हदीस अभी उपलब्ध नहीं है। पढ़ना जारी रखने के लिए नीचे कोई संग्रह चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আজকের হাদিস এখনও উপলব্ধ নয়। পড়া চালিয়ে যেতে নিচে একটি সংকলন বেছে নিন।"
          }
        }
      }
    },

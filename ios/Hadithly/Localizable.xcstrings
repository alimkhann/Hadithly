    "la2.account_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create translations in your language. Keep your place across devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أنشئ ترجمات بلغتك. احتفظ بموضع قراءتك عبر أجهزتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Создавайте переводы на своём языке. Сохраняйте место чтения между устройствами."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Өз тіліңізде аударма жасаңыз. Оқу орныңызды құрылғылар арасында сақтаңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O‘z tilingizda tarjima yarating. O‘qish joyingizni qurilmalar orasida saqlang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kendi dilinizde çeviri oluşturun. Okuduğunuz yeri cihazlar arasında koruyun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buat terjemahan dalam bahasa Anda. Simpan posisi baca antarperangkat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنی زبان میں ترجمے بنائیں۔ اپنے آلات میں پڑھنے کی جگہ محفوظ رکھیں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Өз тилиңизде котормолорду түзүңүз. Окуган жериңизди бардык түзмөктөрдө сактаңыз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Créez des traductions dans votre langue. Retrouvez votre position sur tous vos appareils."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crea traducciones en tu idioma. Conserva tu posición entre dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crie traduções no seu idioma. Mantenha sua posição entre os dispositivos."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unda tafsiri katika lugha yako. Hifadhi nafasi yako kwenye vifaa vyako."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी भाषा में अनुवाद बनाएँ। अपने सभी उपकरणों पर पढ़ने की जगह बनाए रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ভাষায় অনুবাদ তৈরি করুন। সব ডিভাইসে পড়ার অবস্থান ধরে রাখুন।"
          }
        }
      }
    },

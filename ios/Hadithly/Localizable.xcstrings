    "Your suggestion remains private. Withdraw it and submit different evidence if needed." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يظل اقتراحك خاصًا. اسحبه وقدّم أدلة مختلفة عند الحاجة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার প্রস্তাব ব্যক্তিগত থাকে। প্রয়োজন হলে সেটি প্রত্যাহার করে অন্য প্রমাণ জমা দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your suggestion remains private. Withdraw it and submit different evidence if needed."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu propuesta sigue siendo privada. Si es necesario, retírala y envía otra evidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre proposition reste privée. Si nécessaire, retirez-la et envoyez d’autres pièces justificatives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपका सुझाव निजी रहता है। ज़रूरत हो तो उसे वापस लें और दूसरा साक्ष्य भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usulan Anda tetap pribadi. Jika perlu, tarik usulan dan kirim bukti lain."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ұсынысыңыз жеке күйінде қалады. Қажет болса, оны қайтарып алып, басқа дәлелдер жіберіңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сунушуңуз купуя бойдон калат. Керек болсо, аны кайтарып алып, башка далилдерди жөнөтүңүз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua sugestão continua privada. Se necessário, retire-a e envie outras evidências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваше предложение остаётся закрытым. При необходимости отзовите его и отправьте другие доказательства."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pendekezo lako linabaki la faragha. Ikihitajika, liondoe na uwasilishe ushahidi tofauti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öneriniz gizli kalır. Gerekirse geri çekip farklı kanıtlar gönderin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کی تجویز نجی رہتی ہے۔ ضرورت ہو تو اسے واپس لیں اور دوسرا ثبوت جمع کرائیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taklifingiz maxfiy qoladi. Kerak bo‘lsa, uni qaytarib olib, boshqa dalillar yuboring."
          }
        }
      }
    },

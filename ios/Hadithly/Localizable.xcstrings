    "Send crash reports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send crash reports"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إرسال تقارير الأعطال"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کریش کی رپورٹس بھیجیں"
          }
        },
        "ru": {

        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Өшірілсе, оқу көрінісі қолданба көрінісіне сай болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Өчүрүлгөндө, окуу көрүнүшү колдонмонун көрүнүшүнө шайкеш болот."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oʻchirilganda, oʻqish koʻrinishi ilova koʻrinishiga mos boʻladi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapalıyken okuma görünümü uygulama görünümünü izler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika dinonaktifkan, pembaca mengikuti tampilan aplikasi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بند ہونے پر مطالعے کی ظاہری شکل ایپ کے مطابق رہتی ہے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinon, la lecture suit l’apparence de l’application."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si está desactivado, la lectura sigue la apariencia de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando desativado, a leitura segue a aparência do app."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ikizimwa, usomaji hufuata mwonekano wa programu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बंद होने पर पठन का रूप ऐप के रूप के अनुसार रहता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "বন্ধ থাকলে পড়ার চেহারা অ্যাপের চেহারা অনুসরণ করে।"
          }
        }
      }
    },

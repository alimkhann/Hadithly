    "e3.published_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your translation is now available in the reader. Your contribution status stays private."
          }
        },
        "ar": {
          "stringUnit": {

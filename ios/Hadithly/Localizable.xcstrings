    "Start with a letter; use letters, numbers, and underscores.": {
      "comment": "A message displayed in an alert when creating a username.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Start with a letter; use letters, numbers, and underscores."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابدأ بحرف؛ استخدم الحروف والأرقام والشرطات السفلية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Начните с буквы; используйте буквы, цифры и символы подчёркивания."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Әріптен бастаңыз; әріптерді, сандарды және астын сызу таңбасын пайдаланыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тамга менен баштаңыз; тамгаларды, сандарды жана астыңкы сызыкты колдонуңуз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harfdan boshlang; harflar, raqamlar va pastki chiziqdan foydalaning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir harfle başlayın; harf, rakam ve alt çizgi kullanın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mulai dengan huruf; gunakan huruf, angka, dan garis bawah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حرف سے شروع کریں؛ حروف، اعداد اور انڈر اسکور استعمال کریں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Commencez par une lettre ; utilisez des lettres, chiffres et traits de soulignement."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empieza con una letra; usa letras, números y guiones bajos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comece com uma letra; use letras, números e sublinhados."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anza kwa herufi; tumia herufi, nambari na mistari ya chini."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अक्षर से शुरू करें; अक्षर, अंक और अंडरस्कोर इस्तेमाल करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একটি অক্ষর দিয়ে শুরু করুন; অক্ষর, সংখ্যা ও আন্ডারস্কোর ব্যবহার করুন।"
          }
        }
      }
    },
    "Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel in your store account.": {
      "comment": "A footer message explaining subscription terms.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel in your store account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتجدد الاشتراكات تلقائيًا ما لم تُلغَ قبل نهاية الفترة الحالية بـ24 ساعة على الأقل. أدرها أو ألغها في حساب المتجر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подписки продлеваются автоматически, если их не отменить как минимум за 24 часа до конца текущего периода. Управляйте подпиской или отменяйте её в аккаунте магазина."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ағымдағы кезең аяқталғанға дейін кемінде 24 сағат бұрын тоқтатылмаса, жазылымдар автоматты түрде жаңартылады. Дүкен аккаунтында басқарыңыз немесе тоқтатыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Учурдагы мөөнөт бүтөрүнө кеминде 24 саат калганда токтотулбаса, жазылуулар автоматтык жаңыланат. Дүкөн аккаунтуңуздан башкарыңыз же токтотуңуз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Joriy davr tugashidan kamida 24 soat oldin bekor qilinmasa, obunalar avtomatik yangilanadi. Do‘kon hisobida boshqaring yoki bekor qiling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mevcut dönem bitmeden en az 24 saat önce iptal edilmediği sürece abonelikler otomatik yenilenir. Mağaza hesabınızdan yönetin veya iptal edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langganan diperbarui otomatis kecuali dibatalkan setidaknya 24 jam sebelum periode saat ini berakhir. Kelola atau batalkan di akun toko Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سبسکرپشن خودکار طور پر تجدید ہوتی ہے، جب تک موجودہ مدت کے اختتام سے کم از کم 24 گھنٹے پہلے منسوخ نہ کی جائے۔ اسٹور اکاؤنٹ میں انتظام یا منسوخی کریں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période. Gérez-les ou annulez-les dans votre compte de boutique."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las suscripciones se renuevan automáticamente, salvo que las canceles al menos 24 horas antes del final del periodo actual. Adminístralas o cancélalas en tu cuenta de la tienda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As assinaturas são renovadas automaticamente, salvo cancelamento pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele na conta da loja."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usajili hujisasisha kiotomatiki isipokuwa ughairiwe angalau saa 24 kabla ya mwisho wa kipindi cha sasa. Dhibiti au ghairi kwenye akaunti ya duka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वर्तमान अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न करने पर सदस्यताएँ अपने आप नवीनीकृत होती हैं। स्टोर खाते में प्रबंधित या रद्द करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "বর্তমান সময় শেষ হওয়ার অন্তত ২৪ ঘণ্টা আগে বাতিল না করলে সাবস্ক্রিপশন স্বয়ংক্রিয়ভাবে নবায়ন হয়। স্টোর অ্যাকাউন্টে পরিচালনা বা বাতিল করুন।"
          }
        }
      }
    },

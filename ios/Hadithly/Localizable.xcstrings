    "By continuing, you agree to our %1$@. Read our %2$@." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing, you agree to our %1$@. Read our %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بالمتابعة، فإنك توافق على %1$@. اقرأ %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Продолжая, вы принимаете документ «%1$@». Прочитайте документ «%2$@»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жалғастыру арқылы %1$@ құжатын қабылдайсыз. %2$@ құжатын оқыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Улантуу менен %1$@ документин кабыл аласыз. %2$@ документин окуңуз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Davom etish orqali %1$@ hujjatiga rozilik bildirasiz. %2$@ hujjatini oʻqing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Devam ederek %1$@ metnini kabul edersiniz. %2$@ metnini okuyun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dengan melanjutkan, Anda menyetujui %1$@. Baca %2$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جاری رکھنے سے آپ %1$@ سے اتفاق کرتے ہیں۔ ہماری %2$@ پڑھیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En continuant, vous acceptez nos %1$@. Consultez notre %2$@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al continuar, aceptas nuestros %1$@. Lee nuestra %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ao continuar, você aceita nossos %1$@. Leia nossa %2$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kwa kuendelea, unakubali %1$@ yetu. Soma %2$@ yetu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जारी रखकर आप हमारी %1$@ स्वीकार करते हैं। हमारी %2$@ पढ़ें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "চালিয়ে গেলে আপনি আমাদের %1$@ মেনে নিচ্ছেন। আমাদের %2$@ পড়ুন।"
          }
        }
      }
    },

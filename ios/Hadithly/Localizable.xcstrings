        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аудармаңыз енді оқырманда қолжетімді. Үлесіңіздің күйі жеке болып қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Котормоңуз эми окугучта жеткиликтүү. Салымыңыздын абалы жеке бойдон калат."
          }
        },

        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gusa na ushikilie hadith ili kuweka alama, kuongeza dokezo au kushiriki."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुकमार्क, नोट जोड़ने या साझा करने के लिए हदीस को दबाकर रखें।"
          }
        },
        "bn": {
          "stringUnit": {

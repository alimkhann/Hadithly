    "la2.sample_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustrative text by Hadithly, not a hadith. AI translations may contain errors."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نص توضيحي من Hadithly، وليس حديثًا. قد تحتوي ترجمات الذكاء الاصطناعي على أخطاء."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пример текста Hadithly, не хадис. Переводы ИИ могут содержать ошибки."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithly мысал мәтіні, хадис емес. ЖИ аудармасында қате болуы мүмкін."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithly misol matni, hadis emas. SI tarjimalarida xatolar bo‘lishi mumkin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithly örnek metnidir, hadis değildir. Yapay zekâ çevirileri hata içerebilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Teks contoh oleh Hadithly, bukan hadis. Terjemahan AI dapat mengandung kesalahan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithly کا مثالی متن، حدیث نہیں۔ AI ترجمے میں غلطیاں ہو سکتی ہیں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithly жазган мисал текст, хадис эмес. AI котормолорунда каталар болушу мүмкүн."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Texte illustratif de Hadithly, pas un hadith. Les traductions par IA peuvent contenir des erreurs."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Texto ilustrativo de Hadithly, no es un hadiz. Las traducciones de IA pueden contener errores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Texto ilustrativo da Hadithly, não é um hadith. As traduções de IA podem conter erros."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maandishi ya mfano kutoka Hadithly, si hadithi. Tafsiri za AI zinaweza kuwa na makosa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadithly का उदाहरणात्मक पाठ, हदीस नहीं। AI अनुवादों में गलतियाँ हो सकती हैं।"
          }
        },
        "bn": {
          "stringUnit": {

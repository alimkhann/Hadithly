  "la2.cancelled": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Purchase cancelled. You can keep reading."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "تم إلغاء الشراء. يمكنك متابعة القراءة."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Покупка отменена. Можно продолжить чтение."
        }
      },
      "kk": {
        "stringUnit": {
          "state": "translated",
          "value": "Сатып алу тоқтатылды. Оқуды жалғастыра аласыз."
        }
      },
      "uz": {
        "stringUnit": {
          "state": "translated",
          "value": "Xarid bekor qilindi. O‘qishni davom ettirishingiz mumkin."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Satın alma iptal edildi. Okumaya devam edebilirsiniz."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Pembelian dibatalkan. Anda dapat terus membaca."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "خریداری منسوخ۔ آپ پڑھنا جاری رکھ سکتے ہیں۔"
        }
      }
    }
  },
  "la2.pending": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Payment is pending. Pro unlocks after the store confirms it."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "الدفع معلّق. يُفعّل Pro بعد تأكيد المتجر."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Платёж ожидает подтверждения. Pro появится после подтверждения магазина."
        }
      },
      "kk": {
        "stringUnit": {
          "state": "translated",
          "value": "Төлем күтілуде. Pro дүкен растағаннан кейін ашылады."
        }
      },
      "uz": {
        "stringUnit": {
          "state": "translated",
          "value": "To‘lov kutilmoqda. Do‘kon tasdiqlagach Pro ochiladi."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Ödeme bekliyor. Mağaza onayından sonra Pro açılır."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Pembayaran tertunda. Pro terbuka setelah toko mengonfirmasi."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "ادائیگی زیر التوا ہے۔ اسٹور کی تصدیق پر Pro کھلے گا۔"
        }
      }
    }
  },
  "Send crash reports": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Send crash reports"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "إرسال تقارير الأعطال"
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "کریش کی رپورٹس بھیجیں"
        }
      }
    }
  },
  "Optional. Sends redacted failures and build information to Sentry. No reading text or account details. Reports expire after 30 days. Turning off clears pending reports on this device.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Optional. Sends redacted failures and build information to Sentry. No reading text or account details. Reports expire after 30 days. Turning off clears pending reports on this device."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "اختياري. يرسل معلومات الأعطال والإصدار بعد تنقيحها إلى Sentry، دون نصوص القراءة أو تفاصيل الحساب. تنتهي صلاحية التقارير بعد 30 يوماً. يؤدي إيقافه إلى حذف التقارير المعلقة على هذا الجهاز."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "اختیاری۔ Sentry کو حساس معلومات سے پاک خرابیوں اور بلڈ کی معلومات بھیجتا ہے۔ پڑھنے کا متن یا اکاؤنٹ کی تفصیلات شامل نہیں۔ رپورٹس 30 دن بعد ختم ہو جاتی ہیں۔ بند کرنے سے اس آلے کی زیر التوا رپورٹس حذف ہو جاتی ہیں۔"
        }
      }
    }
  },

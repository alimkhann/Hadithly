    "Touch and hold a hadith to bookmark, add a note or share.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a hadith to bookmark, add a note or share."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المس الحديث مطولًا لإضافة علامة أو ملاحظة أو مشاركته."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нажмите и удерживайте хадис, чтобы добавить закладку, заметку или поделиться."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бетбелгі, жазба қосу немесе бөлісу үшін хадисті басып тұрыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кыстарма же жазма кошуу, же бөлүшүү үчүн хадисти басып туруңуз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xatcho‘p yoki qayd qo‘shish yoxud ulashish uchun hadisni bosib turing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yer imi veya not eklemek ya da paylaşmak için hadise dokunup basılı tutun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sentuh dan tahan hadis untuk menandai, menambahkan catatan, atau berbagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نشانی یا نوٹ شامل کرنے یا شیئر کرنے کے لیے حدیث کو دبا کر رکھیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez un hadith de façon prolongée pour ajouter un signet, une note ou le partager."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",

            "value": "Бул аракетти үстүндөгү билдирүүдөн жокко чыгарсаңыз болот."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu amalni yuqoridagi xabardan bekor qilishingiz mumkin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu işlemi üstteki mesajdan geri alabilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda dapat membatalkan tindakan ini dari pesan di bagian atas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez annuler cette action depuis le message en haut."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes deshacer esta acción desde el mensaje de la parte superior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode desfazer esta ação pela mensagem no topo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unaweza kutendua kitendo hiki kutoka kwenye ujumbe wa juu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप ऊपर दिए संदेश से यह कार्रवाई पूर्ववत कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "উপরের বার্তা থেকে এই কাজটি পূর্বাবস্থায় ফেরাতে পারেন।"
          }
        }
      }
    },
    "You reached this month’s free AI limit. Reading, saved items, and existing translations stay free.": {
      "comment": "A description under the title \"More AI translations\" that explains the free access to translations for the current month.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You reached this month’s free AI limit. Reading, saved items, and existing translations stay free."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لقد بلغت الحد المجاني الشهري لترجمات الذكاء الاصطناعي. تبقى القراءة والعناصر المحفوظة والترجمات الموجودة مجانية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы достигли месячного бесплатного лимита переводов ИИ. Чтение, сохранённые материалы и существующие переводы остаются бесплатными."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Осы айдағы тегін AI лимитіне жеттіңіз. Оқу, сақталған элементтер және бар аудармалар тегін болып қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бул айдагы акысыз AI лимитине жеттиңиз. Окуу, сакталган элементтер жана бар котормолор акысыз бойдон калат."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu oy uchun bepul AI limitiga yetdingiz. O‘qish, saqlangan narsalar va mavjud tarjimalar bepul qoladi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu ayın ücretsiz AI sınırına ulaştınız. Okuma, kayıtlı öğeler ve mevcut çeviriler ücretsiz kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda telah mencapai batas AI gratis bulan ini. Membaca, item tersimpan, dan terjemahan yang ada tetap gratis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سیٹنگز سے سائن اِن کریں، پھر اس حدیث پر واپس آئیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez atteint la limite mensuelle gratuite des traductions IA. La lecture, les éléments enregistrés et les traductions existantes restent gratuits."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Llegaste al límite mensual gratuito de IA. La lectura, lo guardado y las traducciones existentes siguen siendo gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você atingiu o limite mensal gratuito de IA. A leitura, os itens salvos e as traduções existentes continuam gratuitos."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Umetumia kikomo cha bure cha AI cha mwezi huu. Kusoma, vilivyohifadhiwa na tafsiri zilizopo hubaki bila malipo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने इस महीने की मुफ़्त AI सीमा पूरी कर ली है। पढ़ना, सहेजी गई चीज़ें और मौजूदा अनुवाद मुफ़्त रहेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই মাসের বিনামূল্যের AI সীমা শেষ হয়েছে। পড়া, সংরক্ষিত জিনিস ও বিদ্যমান অনুবাদ বিনামূল্যেই থাকবে।"
          }
        }
      }
    },

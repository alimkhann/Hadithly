        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يؤدي المسح أبدًا إلى حذف الإشارات المرجعية أو المفضلة أو الملاحظات أو تقدم القراءة أو المجموعات التي تم تنزيلها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Очистка никогда не удаляет закладки, избранное, заметки, прогресс чтения или загруженные коллекции."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тазалау бетбелгілерді, таңдаулыларды, жазбаларды, оқу барысын немесе жүктелген жинақтарды ешқашан жоймайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тазалоо кыстармаларды, сүйүктүүлөрдү, жазмаларды, окуу прогрессин же жүктөлгөн жыйнактарды эч качан өчүрбөйт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tozalash xatcho‘plar, sevimlilar, qaydlar, o‘qish jarayoni yoki yuklangan to‘plamlarni hech qachon o‘chirmaydi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temizleme işlemi yer imlerini, favorileri, notları, okuma ilerlemesini veya indirilen koleksiyonları asla silmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menghapus tidak pernah menghapus penanda, favorit, catatan, kemajuan membaca, atau koleksi yang diunduh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صاف کرنے سے بک مارکس، پسندیدہ، نوٹس، مطالعے کی پیش رفت یا ڈاؤن لوڈ کردہ مجموعے کبھی حذف نہیں ہوتے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suppression ne supprime jamais les signets, favoris, notes, progression de lecture ou collections téléchargées."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Borrar nunca elimina marcadores, favoritos, notas, progreso de lectura ni colecciones descargadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Limpar nunca apaga marcadores, favoritos, notas, progresso de leitura ou coleções baixadas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kusafisha hakufuti kamwe alamisho, vipendwa, madokezo, maendeleo ya kusoma au mikusanyo iliyopakuliwa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "साफ़ करने से बुकमार्क, पसंदीदा, नोट्स, पढ़ने की प्रगति या डाउनलोड की गई संग्रहणियाँ कभी नहीं मिटतीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পরিষ্কার করলে বুকমার্ক, পছন্দের, নোট, পড়ার অগ্রগতি বা ডাউনলোড করা সংগ্রহ মুছে যায় না।"
          }
        }
      }
    },

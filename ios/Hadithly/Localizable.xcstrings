    "la2.renewal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically at the displayed price for the selected billing period. Manage or cancel in your store account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد تلقائيًا بالسعر المعروض للفترة المختارة. يمكنك الإدارة أو الإلغاء في حساب المتجر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое продление по указанной цене за выбранный период. Управление и отмена в аккаунте магазина."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған кезең үшін көрсетілген бағамен автоматты түрде жаңарады. Дүкен тіркелгісінде басқарыңыз не тоқтатыңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanlangan davr uchun ko‘rsatilgan narxda avtomatik yangilanadi. Do‘kon hisobida boshqaring yoki bekor qiling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dönem için gösterilen fiyattan otomatik yenilenir. Mağaza hesabınızdan yönetin veya iptal edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang otomatis dengan harga yang ditampilkan untuk periode terpilih. Kelola atau batalkan di akun toko Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب مدت کے لیے دکھائی گئی قیمت پر خودکار تجدید ہوتی ہے۔ اسٹور اکاؤنٹ میں انتظام یا منسوخی کریں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renews automatically at the displayed price for the selected billing period. Manage or cancel in your store account."
          }
        },
        "fr": {

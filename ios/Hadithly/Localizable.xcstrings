    "AI translations are labeled and may contain errors. Source details appear when available." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI translations are labeled and may contain errors. Source details appear when available."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُميَّز ترجمات الذكاء الاصطناعي وقد تحتوي على أخطاء. تظهر تفاصيل المصادر عند توفرها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переводы ИИ помечены и могут содержать ошибки. Сведения об источниках показываются при наличии."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ЖИ аудармалары белгіленеді және қателер болуы мүмкін. Дереккөз мәліметтері бар болса көрсетіледі."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ЖИ котормолору белгиленет жана каталарды камтышы мүмкүн. Булак маалыматы бар болсо көрсөтүлөт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "SI tarjimalari belgilangan va xatolarni oʻz ichiga olishi mumkin. Manba tafsilotlari mavjud boʻlsa koʻrsatiladi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yapay zekâ çevirileri etiketlenir ve hata içerebilir. Kaynak bilgileri mevcut olduğunda gösterilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjemahan AI diberi label dan dapat mengandung kesalahan. Detail sumber ditampilkan jika tersedia."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AI تراجم کی نشاندہی کی جاتی ہے اور ان میں غلطیاں ہو سکتی ہیں۔ ذرائع کی تفصیلات دستیاب ہونے پر دکھائی جاتی ہیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les traductions par IA sont signalées et peuvent contenir des erreurs. Les sources sont détaillées lorsqu’elles sont disponibles."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las traducciones con IA están identificadas y pueden contener errores. Los detalles de las fuentes aparecen cuando están disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As traduções por IA são identificadas e podem conter erros. Os detalhes das fontes aparecem quando disponíveis."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafsiri za AI zinawekewa alama na zinaweza kuwa na makosa. Maelezo ya vyanzo huonekana yanapopatikana."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AI अनुवाद चिह्नित होते हैं और उनमें त्रुटियाँ हो सकती हैं। स्रोतों का विवरण उपलब्ध होने पर दिखाया जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "AI অনুবাদ চিহ্নিত থাকে এবং এতে ভুল থাকতে পারে। উৎসের বিবরণ পাওয়া গেলে দেখানো হয়।"
          }
        }
      }
    },

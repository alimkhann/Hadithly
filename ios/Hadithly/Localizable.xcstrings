    "q1.quota_exhausted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rolling seven-day allowance is used. Existing translations and reading stay free."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدمت حصة الأيام السبعة المتحركة. تبقى القراءة والترجمات الموجودة مجانية."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کی گزشتہ سات دنوں کی حد استعمال ہو چکی ہے۔ موجودہ ترجمے اور مطالعہ مفت رہیں گے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваш скользящий семидневный лимит использован. Существующие переводы и чтение остаются бесплатными."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жылжымалы жеті күндік лимитіңіз қолданылды. Бар аудармалар мен оқу тегін болып қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жети күндүк чегиңиз колдонулду. Учурдагы котормолор жана окуу акысыз бойдон калат."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yetti kunlik harakatlanuvchi limitingiz ishlatildi. Mavjud tarjimalar va o‘qish bepul qoladi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kayan yedi günlük hakkınız kullanıldı. Mevcut çeviriler ve okuma ücretsiz kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jatah bergulir tujuh hari Anda telah digunakan. Terjemahan yang ada dan bacaan tetap gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre quota de sept jours est épuisé. La lecture et les traductions existantes restent gratuites."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usaste tu cuota de siete días. La lectura y las traducciones existentes siguen siendo gratuitas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sua cota de sete dias foi usada. A leitura e as traduções existentes continuam gratuitas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kikomo chako cha siku saba kimetumika. Kusoma na tafsiri zilizopo bado ni bure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी सात-दिन की सीमा पूरी हो गई है। पढ़ना और मौजूदा अनुवाद मुफ़्त रहेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার সাত দিনের সীমা শেষ হয়েছে। পড়া এবং বিদ্যমান অনুবাদ বিনামূল্যে থাকবে।"

    "la2.allowance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 free or 100 Pro new translations in a rolling 7 days. Approved and cached translations stay free."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "5 ترجمات جديدة مجانًا أو 100 مع Pro خلال آخر 7 أيام. الترجمات المعتمدة والمخزنة تبقى مجانية."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "5 новых переводов бесплатно или 100 с Pro за скользящие 7 дней. Готовые и одобренные переводы бесплатны."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Соңғы 7 күнде 5 тегін немесе Pro-мен 100 жаңа аударма. Бекітілген және сақталған аудармалар тегін."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oxirgi 7 kunda 5 bepul yoki Pro bilan 100 yangi tarjima. Tasdiqlangan va saqlangan tarjimalar bepul."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Son 7 günde ücretsiz 5 veya Pro ile 100 yeni çeviri. Onaylı ve önbellekteki çeviriler ücretsizdir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "5 terjemahan baru gratis atau 100 dengan Pro dalam 7 hari berjalan. Terjemahan yang disetujui dan tersimpan tetap gratis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "گزشتہ مسلسل 7 دنوں میں 5 مفت یا Pro کے ساتھ 100 نئے ترجمے۔ منظور شدہ اور محفوظ ترجمے مفت رہتے ہیں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жылып турган 7 күндө 5 жаңы котормо акысыз же Pro менен 100. Бекитилген жана кэштелген котормолор акысыз бойдон калат."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "5 nouvelles traductions gratuites ou 100 avec Pro sur 7 jours glissants. Les traductions approuvées et en cache restent gratuites."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "5 traducciones nuevas gratis o 100 con Pro durante 7 días corridos. Las traducciones aprobadas y guardadas en caché siguen siendo gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "5 novas traduções gratuitas ou 100 com Pro em 7 dias corridos. Traduções aprovadas e armazenadas em cache continuam gratuitas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafsiri mpya 5 bila malipo au 100 ukiwa na Pro ndani ya siku 7 zinazosogea. Tafsiri zilizoidhinishwa na zilizohifadhiwa hubaki bila malipo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लगातार 7 दिनों में 5 नए अनुवाद मुफ़्त या Pro के साथ 100। स्वीकृत और कैश किए गए अनुवाद मुफ़्त रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "চলমান ৭ দিনে ৫টি নতুন অনুবাদ বিনামূল্যে, অথবা Pro-তে ১০০টি। অনুমোদিত ও ক্যাশ করা অনুবাদ বিনামূল্যে থাকে।"
          }
        }
      }
    },

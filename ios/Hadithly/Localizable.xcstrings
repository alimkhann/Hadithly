        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бұл әрекетті жоғарыдағы хабарламадан болдырмауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бул аракетти үстүндөгү билдирүүдөн жокко чыгарсаңыз болот."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu amalni yuqoridagi xabardan bekor qilishingiz mumkin."

    "q1.remaining": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven-day allowance: %1$d of %2$d left"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متبقي %1$d من %2$d ترجمة جديدة خلال سبعة أيام"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سات دنوں میں %2$d میں سے %1$d نئے ترجمے باقی ہیں"
          }
        }
      }
    },
    "q1.retry_at": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available again %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح مجددًا %1$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ دستیاب: %1$@"
          }
        }
      }
    },
    "q1.quota_exhausted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rolling seven-day allowance is used. Existing translations and reading stay free."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمت حصة الأيام السبعة المتحركة. تبقى القراءة والترجمات الموجودة مجانية."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی گزشتہ سات دنوں کی حد استعمال ہو چکی ہے۔ موجودہ ترجمے اور مطالعہ مفت رہیں گے۔"
          }
        }
      }
    },
    "e4.appeal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request an appeal"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب استئناف"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپیل کی درخواست"
          }
        }
      }
    },
    "e4.appeal_reason": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain what should be checked again"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضّح ما ينبغي إعادة فحصه"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بتائیں کہ کیا دوبارہ جانچنا چاہیے"
          }
        }
      }
    },
    "e4.appeal_window": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can request one automatic appeal within 30 days. It does not extend evidence retention."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن طلب استئناف آلي واحد خلال 30 يومًا. لا يمدد مدة الاحتفاظ بالأدلة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ 30 دن کے اندر ایک خودکار اپیل کی درخواست کر سکتے ہیں۔ اس سے شواہد رکھنے کی مدت نہیں بڑھتی۔"
          }
        }
      }
    },
    "e4.appeal_processing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal is being checked automatically."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري فحص استئنافك آليًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپیل کی خودکار جانچ ہو رہی ہے۔"
          }
        }
      }
    },
    "e4.appeal_resolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appeal is complete. The suggestion status shows the result."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل الاستئناف. تظهر النتيجة في حالة الاقتراح."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپیل مکمل ہو گئی ہے۔ نتیجہ تجویز کی حالت میں دکھایا گیا ہے۔"
          }
        }
      }
    },
    "e4.appeal_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The appeal could not be requested. Check the window and try again when connected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر طلب الاستئناف. تحقق من المهلة وحاول عند الاتصال."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپیل کی درخواست نہیں ہو سکی۔ مدت چیک کریں اور رابطہ ہونے پر دوبارہ کوشش کریں۔"
          }
        }
      }
    },
    "e4.revoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publication withdrawn"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُحب النشر"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اشاعت واپس لے لی گئی"
          }
        }
      }
    },
    "e4.revoked_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This suggestion is private while its publication is reassessed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الاقتراح خاص أثناء إعادة تقييم نشره."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اشاعت کی دوبارہ جانچ کے دوران یہ تجویز نجی ہے۔"
          }
        }
      }
    },
    "e3.report_saved_detail" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports are saved privately. You can keep reading."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ البلاغات بشكل خاص. يمكنك متابعة القراءة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹس نجی طور پر محفوظ ہوتی ہیں۔ آپ پڑھنا جاری رکھ سکتے ہیں۔"
          }
        }
      }
    },

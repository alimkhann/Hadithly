    "la2.renewal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically. Manage or cancel in your store account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتجدد الاشتراكات تلقائيًا. يمكنك إدارتها أو إلغاؤها من حسابك في المتجر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подписка продлевается автоматически. Управлять ей и отменить её можно в аккаунте магазина."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жазылым автоматты түрде жаңартылады. Оны дүкендегі аккаунтыңыздан басқаруға немесе тоқтатуға болады."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obuna avtomatik yangilanadi. Uni do‘kondagi hisobingizdan boshqarishingiz yoki bekor qilishingiz mumkin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abonelikler otomatik yenilenir. Mağaza hesabınızdan yönetebilir veya iptal edebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langganan diperpanjang otomatis. Kelola atau batalkan di akun toko Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سبسکرپشن خود بخود تجدید ہوتی ہے۔ اپنے اسٹور اکاؤنٹ میں اس کا نظم کریں یا منسوخ کریں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жазылуу автоматтык түрдө узартылат. Аны дүкөндөгү аккаунтуңуздан башкарып же токтото аласыз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les abonnements se renouvellent automatiquement. Gérez ou annulez votre abonnement dans votre compte de boutique."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suscripción se renueva automáticamente. Adminístrala o cancélala en tu cuenta de la tienda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As assinaturas são renovadas automaticamente. Gerencie ou cancele na sua conta da loja."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usajili hujisasisha kiotomatiki. Dhibiti au ughairi katika akaunti yako ya duka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सदस्यता अपने आप नवीनीकृत होती है। अपने स्टोर खाते में इसे प्रबंधित या रद्द करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সাবস্ক্রিপশন স্বয়ংক্রিয়ভাবে নবায়ন হয়। আপনার স্টোর অ্যাকাউন্ট থেকে পরিচালনা বা বাতিল করুন।"
          }
        }
      }
    },

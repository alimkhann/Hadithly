    "Read the hadith collections in your language — clean, calm, and true to the sources.": {
      "comment": "A description of the app's features, emphasizing its focus on accuracy and authenticity.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Read the hadith collections in your language — clean, calm, and true to the sources."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقرأ مجموعات الحديث بلغتك — بوضوح وهدوء ووفاء للمصادر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Читайте сборники хадисов на своём языке — спокойно, ясно и верно источникам."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хадис жинақтарын өз тіліңізде оқыңыз — анық, тыныш және дереккөздерге адал."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хадис жыйнактарын өз тилиңизде окуңуз — түшүнүктүү, тынч жана булактарга берилген."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadis to‘plamlarini o‘z tilingizda o‘qing — aniq, sokin va manbalarga sodiq."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hadis koleksiyonlarını kendi dilinizde okuyun — temiz, sakin ve kaynaklara sadık."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baca koleksi hadis dalam bahasa Anda — jelas, tenang, dan setia pada sumbernya."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنی زبان میں احادیث کے مجموعے پڑھیں — صاف، پُرسکون اور ماخذ کے مطابق۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisez les recueils de hadiths dans votre langue — avec calme, clarté et fidélité aux sources."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lee las colecciones de hadices en tu idioma, con claridad, calma y fidelidad a las fuentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leia as coleções de hadiths no seu idioma — com clareza, calma e fidelidade às fontes."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soma mikusanyo ya hadithi kwa lugha yako — kwa uwazi, utulivu na uaminifu kwa vyanzo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी भाषा में हदीस संग्रह पढ़ें — साफ़, शांत और स्रोतों के प्रति सच्चे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ভাষায় হাদিসের সংগ্রহ পড়ুন — পরিষ্কার, শান্ত এবং উৎসের প্রতি বিশ্বস্ত।"
          }
        }
      }
    },

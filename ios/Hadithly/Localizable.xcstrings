    "e4.appeal_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The appeal could not be requested. Check the window and try again when connected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر طلب الاستئناف. تحقق من المهلة وحاول عند الاتصال."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپیل کی درخواست نہیں ہو سکی۔ مدت چیک کریں اور رابطہ ہونے پر دوبارہ کوشش کریں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось запросить апелляцию. Проверьте срок и повторите попытку при подключении."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Апелляцияны сұрау мүмкін болмады. Мерзімді тексеріп, байланыс болғанда қайталап көріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Апелляция суралган жок. Мөөнөттү текшерип, байланыш болгондо кайра аракет кылыңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apellyatsiya so‘rab bo‘lmadi. Muddatni tekshiring va ulanish mavjud bo‘lganda qayta urinib ko‘ring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İtiraz istenemedi. Süreyi kontrol edin ve bağlantınız varken tekrar deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Banding tidak dapat diminta. Periksa waktunya dan coba lagi saat tersambung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le recours n’a pas pu être demandé. Vérifiez le délai et réessayez lorsque vous êtes connecté."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo solicitar la apelación. Comprueba el plazo e inténtalo de nuevo cuando tengas conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível solicitar a apelação. Verifique o prazo e tente novamente quando estiver conectado."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rufaa haikuweza kuombwa. Angalia muda na ujaribu tena ukiwa umeunganishwa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपील का अनुरोध नहीं किया जा सका। अवधि जाँचें और कनेक्शन होने पर फिर कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপিলের অনুরোধ করা যায়নি। সময়সীমা পরীক্ষা করে সংযোগ থাকলে আবার চেষ্টা করুন।"
          }
        }
      }
    },

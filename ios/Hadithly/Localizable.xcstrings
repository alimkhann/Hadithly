        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعمال کا دارومدار نیتوں پر ہے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les actes sont jugés selon les intentions."
          }

        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafsiri hii ilitengenezwa na AI (%@). Si tafsiri yenye mamlaka; thibitisha maana muhimu kwa chanzo chenye sifa."
          }

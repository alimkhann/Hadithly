        }
      }
    },
    "This removes your synced bookmarks, favorites, notes, reading progress, submissions, and sign-in. It cannot be undone." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes your synced bookmarks, favorites, notes, reading progress, submissions, and sign-in. It cannot be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيؤدي هذا إلى إزالة بياناتك المتزامنة من الإشارات المرجعية والمفضلة والملاحظات وتقدم القراءة والمساهمات، وإلغاء تسجيل دخولك. لا يمكن التراجع عن ذلك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При этом удаляются ваши синхронизированные закладки, избранное, заметки, прогресс чтения и отправленные материалы, а также данные для входа. Отменить это действие нельзя."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Синхрондалған бетбелгілеріңіз, таңдаулыларыңыз, жазбаларыңыз, оқу барысыңыз, жіберген материалдарыңыз және жүйеге кіру деректеріңіз жойылады. Бұл әрекетті кері қайтару мүмкін емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Шайкештештирилген кыстармаларыңыз, тандалмаларыңыз, жазууларыңыз, окуу жүрүшүңүз, жөнөткөн материалдарыңыз жана кирүү маалыматтарыңыз өчүрүлөт. Бул аракетти артка кайтаруу мүмкүн эмес."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinxronlangan xatcho‘plaringiz, sevimlilaringiz, qaydlaringiz, o‘qish jarayoningiz, yuborgan materiallaringiz va kirish ma’lumotlaringiz o‘chiriladi. Bu amalni ortga qaytarib bo‘lmaydi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senkronize yer işaretleriniz, favorileriniz, notlarınız, okuma ilerlemeniz, gönderimleriniz ve oturum açma bilgileriniz silinir. Bu işlem geri alınamaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tindakan ini menghapus penanda, favorit, catatan, progres membaca, kiriman, dan informasi masuk Anda yang tersinkron. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اس سے آپ کے مطابقت پذیر بُک مارکس، پسندیدہ مواد، نوٹس، مطالعے کی پیش رفت، بھیجا گیا مواد اور سائن اِن کی معلومات حذف ہو جائیں گی۔ یہ عمل واپس نہیں کیا جا سکتا۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette action supprime vos marque-pages, favoris, notes, progression de lecture, contributions et informations de connexion synchronisés. Elle est irréversible."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto elimina tus marcadores, favoritos, notas, progreso de lectura, envíos e información de inicio de sesión sincronizados. Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isso exclui seus marcadores, favoritos, notas, progresso de leitura, envios e dados de login sincronizados. Essa ação não pode ser desfeita."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hii itaondoa alamisho, vipendwa, madokezo, maendeleo ya usomaji, michango na taarifa zako za kuingia zilizosawazishwa. Hatua hii haiwezi kutenduliwa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इससे आपके सिंक किए गए बुकमार्क, पसंदीदा, नोट्स, पढ़ने की प्रगति, भेजी गई सामग्री और साइन-इन की जानकारी मिट जाएगी। यह कार्रवाई वापस नहीं ली जा सकती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এতে আপনার সিঙ্ক করা বুকমার্ক, পছন্দের তালিকা, নোট, পড়ার অগ্রগতি, জমা দেওয়া বিষয় এবং সাইন-ইন তথ্য মুছে যাবে। এই কাজ পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        }
      }
    },

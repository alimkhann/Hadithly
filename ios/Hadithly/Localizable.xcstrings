            "value": "Дела оцениваются по намерениям."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Амал ниетке қарай бағаланады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Иштер ниетке жараша бааланат."
          }
        },
        "uz": {

    "Download your profile, settings, saved items, folders, reading progress and contributions. Guest data stays on this device." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download your profile, settings, saved items, folders, reading progress and contributions. Guest data stays on this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نزّل ملفك الشخصي وإعداداتك والعناصر المحفوظة والمجلدات وتقدّم القراءة ومساهماتك. تبقى بيانات الضيف على هذا الجهاز."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скачайте свой профиль, настройки, сохранённые элементы, папки, прогресс чтения и свои материалы. Данные гостя остаются на этом устройстве."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профиліңізді, баптауларды, сақталған элементтерді, қалталарды, оқу барысын және қосқан материалдарыңызды жүктеп алыңыз. Қонақ деректері осы құрылғыда қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профилиңизди, жөндөөлөрдү, сакталган нерселерди, папкаларды, окуу жүрүшүн жана кошкон материалдарыңызды жүктөп алыңыз. Коноктун дайындары ушул түзмөктө калат."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilingiz, sozlamalar, saqlangan elementlar, papkalar, oʻqish jarayoni va hissalaringizni yuklab oling. Mehmon maʼlumotlari shu qurilmada qoladi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilinizi, ayarlarınızı, kaydedilen öğeleri, klasörleri, okuma ilerlemesini ve katkılarınızı indirin. Misafir verileri bu cihazda kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unduh profil, pengaturan, item tersimpan, folder, kemajuan membaca, dan kontribusi Anda. Data tamu tetap berada di perangkat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنا پروفائل، ترتیبات، محفوظ کردہ آئٹمز، فولڈرز، پڑھنے کی پیش رفت اور اپنی شراکتیں ڈاؤن لوڈ کریں۔ مہمان کا ڈیٹا اسی ڈیوائس پر رہتا ہے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Téléchargez votre profil, vos réglages, vos éléments enregistrés, vos dossiers, votre progression de lecture et vos contributions. Les données du mode invité restent sur cet appareil."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descarga tu perfil, configuración, elementos guardados, carpetas, progreso de lectura y contribuciones. Los datos de invitado permanecen en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baixe seu perfil, configurações, itens salvos, pastas, progresso de leitura e contribuições. Os dados de visitante permanecem neste dispositivo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pakua wasifu wako, mipangilio, vipengee ulivyohifadhi, folda, maendeleo ya usomaji na michango yako. Data ya mgeni hubaki kwenye kifaa hiki."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी प्रोफ़ाइल, सेटिंग्स, सहेजे गए आइटम, फ़ोल्डर, पढ़ने की प्रगति और योगदान डाउनलोड करें। अतिथि का डेटा इसी डिवाइस पर रहता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার প্রোফাইল, সেটিংস, সংরক্ষিত আইটেম, ফোল্ডার, পড়ার অগ্রগতি ও অবদান ডাউনলোড করুন। অতিথির ডেটা এই ডিভাইসেই থাকে।"
          }
        }
      }
    },
    "e3.community_sources_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A contributor suggested this translation. Automated reviews checked it against the cited evidence. It is not an authoritative rendering."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقترح أحد المساهمين هذه الترجمة، وتحققت المراجعات الآلية منها بمقارنتها بالأدلة المذكورة. وهي ليست ترجمة معتمدة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ایک شراکت کنندہ نے یہ ترجمہ تجویز کیا۔ خودکار جائزوں نے اسے حوالہ دیے گئے ثبوت سے جانچا۔ یہ مستند ترجمہ نہیں ہے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Участник предложил этот перевод. Автоматические проверки сопоставили его с указанными доказательствами. Это не авторитетный перевод."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Қатысушы бұл аударманы ұсынды. Автоматты тексерулер оны келтірілген дәлелдермен салыстырды. Бұл беделді аударма емес."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Катышуучу бул котормону сунуштады. Автоматтык текшерүүлөр аны келтирилген далилдер менен салыштырды. Бул расмий котормо эмес."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hissa qo‘shuvchi bu tarjimani taklif qildi. Avtomatik tekshiruvlar uni keltirilgan dalillar bilan solishtirdi. Bu vakolatli tarjima emas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bir katkıda bulunan bu çeviriyi önerdi. Otomatik kontroller çeviriyi belirtilen kanıtlarla karşılaştırdı. Bu yetkili bir çeviri değildir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seorang kontributor mengusulkan terjemahan ini. Pemeriksaan otomatis membandingkannya dengan bukti yang dikutip. Ini bukan terjemahan otoritatif."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un contributeur a proposé cette traduction. Les vérifications automatiques l’ont comparée aux preuves citées. Ce n’est pas une traduction faisant autorité."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un colaborador propuso esta traducción. Las revisiones automáticas la compararon con las pruebas citadas. No es una versión autorizada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um colaborador sugeriu esta tradução. As revisões automáticas a compararam com as evidências citadas. Ela não é uma tradução autorizada."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mchangiaji alipendekeza tafsiri hii. Ukaguzi wa kiotomatiki uliilinganisha na ushahidi uliotajwa. Si tafsiri yenye mamlaka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक योगदानकर्ता ने यह अनुवाद सुझाया। स्वचालित जाँचों ने इसे उद्धृत साक्ष्य से मिलाया। यह प्रामाणिक अनुवाद नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "একজন অবদানকারী এই অনুবাদ প্রস্তাব করেছেন। স্বয়ংক্রিয় পর্যালোচনা উদ্ধৃত প্রমাণের সঙ্গে এটি মিলিয়েছে। এটি প্রামাণ্য অনুবাদ নয়।"
          }
        }
      }
    },

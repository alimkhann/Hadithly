          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ақаулар туралы есептерді жіберу"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ката тууралуу отчетторду жөнөтүү"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",

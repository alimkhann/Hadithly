    "You can undo this action from the message at the top.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك التراجع عن هذا الإجراء من الرسالة في الأعلى."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ اوپر موجود پیغام سے یہ عمل واپس کر سکتے ہیں۔"

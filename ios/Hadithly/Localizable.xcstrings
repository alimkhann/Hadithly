    "Everything you need to read works without an account. Sign in to carry your bookmarks, favorites, and notes across devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you need to read works without an account. Sign in to carry your bookmarks, favorites, and notes across devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك القراءة دون حساب. سجّل الدخول لمزامنة إشاراتك المرجعية ومفضلاتك وملاحظاتك بين أجهزتك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ بغیر اکاؤنٹ کے مطالعہ کر سکتے ہیں۔ اپنے بُک مارکس، پسندیدہ احادیث اور نوٹس کو مختلف آلات پر رکھنے کے لیے سائن ان کریں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всё необходимое для чтения работает без аккаунта. Войдите, чтобы переносить закладки, избранное и заметки между устройствами."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оқу үшін қажеттінің бәрі аккаунтсыз жұмыс істейді. Бетбелгілерді, таңдаулыларды және жазбаларды құрылғылар арасында алып жүру үшін кіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Окуу үчүн керектүүнүн баары аккаунтсуз иштейт. Кыстармаларды, сүйүктүүлөрдү жана жазмаларды түзмөктөр арасында алып жүрүү үчүн кириңиз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O‘qish uchun kerak bo‘lgan hamma narsa hisobsiz ishlaydi. Xatcho‘p, sevimli va qaydlarni qurilmalar o‘rtasida olib yurish uchun kiring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okumak için gereken her şey hesap olmadan çalışır. Yer imlerinizi, favorilerinizi ve notlarınızı cihazlar arasında taşımak için giriş yapın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semua yang Anda perlukan untuk membaca berfungsi tanpa akun. Masuk untuk membawa penanda, favorit, dan catatan antarperangkat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout ce qu’il faut pour lire fonctionne sans compte. Connectez-vous pour emporter vos signets, favoris et notes sur tous vos appareils."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo lo necesario para leer funciona sin cuenta. Inicia sesión para llevar tus marcadores, favoritos y notas entre dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo o que você precisa para ler funciona sem uma conta. Entre para levar marcadores, favoritos e notas entre dispositivos."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kila kitu unachohitaji kusoma hufanya kazi bila akaunti. Ingia ili kubeba alamisho, vipendwa na madokezo kati ya vifaa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पढ़ने के लिए ज़रूरी सब कुछ बिना खाते के चलता है। उपकरणों के बीच बुकमार्क, पसंदीदा और नोट्स ले जाने के लिए साइन इन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অ্যাকাউন্ট ছাড়াই পড়ার সব সুবিধা চলে। ডিভাইসগুলোর মধ্যে বুকমার্ক, পছন্দের ও নোট নিতে সাইন ইন করুন।"
          }
        }
      }
    },
    "Export your profile, preferences, Saved items, folders, reading progress, and your own contributions as JSON. Guest data never leaves this device.": {
      "comment": "A footer text in the \"Privacy & data\" section of the settings view, explaining that user data is not shared with third parties.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Export your profile, preferences, Saved items, folders, reading progress, and your own contributions as JSON. Guest data never leaves this device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "صدّر ملفك الشخصي وتفضيلاتك وعناصرك المحفوظة ومجلداتك وتقدم القراءة ومساهماتك بصيغة JSON. لا تغادر بيانات الضيف هذا الجهاز."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Экспортируйте профиль, настройки, сохранённые материалы, папки, прогресс чтения и собственные предложения в JSON. Данные гостя не покидают это устройство."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профильді, баптауларды, сақталған элементтерді, қалталарды, оқу барысын және өз үлестеріңізді JSON ретінде экспорттаңыз. Қонақ деректері бұл құрылғыдан шықпайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профилиңизди, жөндөөлөрүңүздү, сакталган элементтерди, папкаларды, окуу прогрессин жана өз салымдарыңызды JSON катары экспорттоңуз. Коноктун дайындары бул түзмөктөн чыкпайт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil, sozlamalar, saqlangan narsalar, papkalar, o‘qish jarayoni va o‘z hissalaringizni JSON sifatida eksport qiling. Mehmon ma’lumotlari bu qurilmadan chiqmaydi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilinizi, tercihlerinizi, kayıtlı öğelerinizi, klasörlerinizi, okuma ilerlemenizi ve kendi katkılarınızı JSON olarak dışa aktarın. Misafir verileri bu cihazdan ayrılmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ekspor profil, preferensi, item tersimpan, folder, kemajuan membaca, dan kontribusi Anda sendiri sebagai JSON. Data tamu tidak pernah meninggalkan perangkat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنا پروفائل، ترجیحات، محفوظ کردہ آئٹمز، فولڈرز، مطالعے کی پیش رفت اور اپنی شراکتیں JSON میں برآمد کریں۔ مہمان کا ڈیٹا اس آلے سے باہر نہیں جاتا۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exportez votre profil, vos préférences, vos éléments enregistrés, vos dossiers, votre progression de lecture et vos propres contributions au format JSON. Les données invité restent sur cet appareil."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exporta tu perfil, preferencias, elementos guardados, carpetas, progreso de lectura y tus propias contribuciones como JSON. Los datos de invitado nunca salen de este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Exporte seu perfil, preferências, itens salvos, pastas, progresso de leitura e suas próprias contribuições como JSON. Os dados de convidado nunca saem deste dispositivo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hamisha wasifu, mapendeleo, vipengee vilivyohifadhiwa, folda, maendeleo ya kusoma na michango yako kama JSON. Data ya mgeni haiondoki kwenye kifaa hiki."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी प्रोफ़ाइल, प्राथमिकताएँ, सहेजी गई चीज़ें, फ़ोल्डर, पढ़ने की प्रगति और अपने योगदान JSON के रूप में निर्यात करें। अतिथि डेटा इस उपकरण से बाहर नहीं जाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার প্রোফাইল, পছন্দ, সংরক্ষিত জিনিস, ফোল্ডার, পড়ার অগ্রগতি ও নিজের অবদান JSON হিসেবে রপ্তানি করুন। অতিথির ডেটা এই ডিভাইস ছাড়ে না।"
          }
        }
      }
    },

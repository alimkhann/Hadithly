        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कर्मों का मूल्यांकन इरादों से होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "কাজের বিচার নিয়তের ভিত্তিতে হয়।"
          }
        }
      }
    },

    "la2.suggested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested from your device. You can change it later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراح من جهازك. يمكنك تغييره لاحقًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложено по языку устройства. Можно изменить позже."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құрылғы тіліне сай ұсынылды. Кейін өзгерте аласыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qurilmangiz tiliga mos tavsiya. Keyin o‘zgartirishingiz mumkin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazınıza göre önerildi. Daha sonra değiştirebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan dari perangkat Anda. Dapat diubah nanti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے آلے کے مطابق تجویز۔ بعد میں بدل سکتے ہیں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Түзмөгүңүздүн тили боюнча сунушталды. Кийин өзгөртө аласыз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suggestion basée sur la langue de votre appareil. Vous pourrez la modifier plus tard."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sugerido según el idioma de tu dispositivo. Puedes cambiarlo después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sugerido com base no idioma do seu dispositivo. Você pode mudar depois."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imependekezwa kulingana na lugha ya kifaa chako. Unaweza kubadilisha baadaye."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपके डिवाइस की भाषा के आधार पर सुझाया गया। आप इसे बाद में बदल सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ডিভাইসের ভাষা অনুযায়ী প্রস্তাবিত। পরে বদলাতে পারবেন।"
          }
        }
      }
    },

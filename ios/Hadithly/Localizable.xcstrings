        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жазылымыңызды көру үшін кіріңіз. Сатып алулар барлық құрылғыларыңызда Hadithly аккаунтыңызға байланып қалады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жазылууңузду көрүү үчүн кириңиз. Сатып алууларыңыз бардык түзмөктөрдө Hadithly аккаунтуңузга байланган бойдон калат."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obunangizni ko‘rish uchun kiring. Xaridlaringiz barcha qurilmalarda Hadithly hisobingizga bog‘langan bo‘ladi."

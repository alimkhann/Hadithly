    "A quiet reader for the seven major hadith collections. Arabic text is licensed from its sources; AI translations are always labeled.": {
      "comment": "A description of the app, highlighting its focus on hadith reading and the dual licensing of Arabic text and AI-generated translations.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A quiet reader for the seven major hadith collections. Arabic text is licensed from its sources; AI translations are always labeled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قارئ هادئ للمجموعات السبعة الكبرى من الأحاديث. النص العربي مرخّص من مصادره، وترجمات الذكاء الاصطناعي مبيّنة دائمًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спокойная читалка для семи основных сборников хадисов. Арабский текст используется по лицензии источников; переводы ИИ всегда помечены."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жеті негізгі хадис жинағына арналған тыныш оқырман. Араб мәтіні дереккөздерінен лицензияланған; AI аудармалары әрдайым белгіленеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жети негизги хадис жыйнагы үчүн тынч окугуч. Араб тексти булактарынан лицензияланган; AI котормолору дайыма белгиленет."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yetti asosiy hadis to‘plami uchun sokin o‘quvchi. Arabcha matn manbalaridan litsenziyalangan; SI tarjimalari doim belgilanadi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yedi büyük hadis koleksiyonu için sakin bir okuyucu. Arapça metin kaynaklarından lisanslıdır; AI çevirileri her zaman belirtilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pembaca tenang untuk tujuh koleksi hadis utama. Teks Arab berlisensi dari sumbernya; terjemahan AI selalu diberi label."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سات بڑے حدیث مجموعوں کے لیے ایک پُرسکون قاری۔ عربی متن اپنے ذرائع سے لائسنس یافتہ ہے؛ AI تراجم ہمیشہ واضح کیے جاتے ہیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un lecteur calme pour les sept grands recueils de hadiths. Le texte arabe est utilisé sous licence de ses sources ; les traductions par IA sont toujours signalées."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un lector tranquilo para las siete grandes colecciones de hadices. El texto árabe tiene licencia de sus fuentes; las traducciones con IA siempre están identificadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um leitor tranquilo para as sete principais coleções de hadiths. O texto árabe é licenciado por suas fontes; as traduções de IA são sempre identificadas."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Msomaji mtulivu wa makusanyo saba makuu ya hadithi. Maandishi ya Kiarabu yana leseni kutoka vyanzo vyake; tafsiri za AI huwekwa alama kila wakati."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सात प्रमुख हदीस संग्रहों के लिए शांत रीडर। अरबी पाठ इसके स्रोतों से लाइसेंस प्राप्त है; AI अनुवादों पर हमेशा लेबल लगा होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সাতটি প্রধান হাদিস সংগ্রহের জন্য শান্ত পাঠক। আরবি লেখা উৎস থেকে লাইসেন্সপ্রাপ্ত; AI অনুবাদে সবসময় লেবেল থাকে।"
          }
        }
      }
    },
    "Actions are judged by intentions.": {
      "localizations": {
        "en": {
          "stringUnit": {

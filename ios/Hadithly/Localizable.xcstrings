        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह अनुवाद AI (%@) ने बनाया है। यह प्रमाणिक रूप नहीं है; महत्वपूर्ण अर्थों को योग्य स्रोत से जाँचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই অনুবাদটি AI (%@) তৈরি করেছে। এটি প্রামাণিক রূপ নয়; গুরুত্বপূর্ণ অর্থ যোগ্য উৎসের সঙ্গে যাচাই করুন।"
          }
        }
      }
    },

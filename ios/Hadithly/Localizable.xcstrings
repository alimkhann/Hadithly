    "Translate missing text automatically, within your allowance. Turn off to translate on request." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate missing text automatically, within your allowance. Turn off to translate on request."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ترجمة النص غير المترجم تلقائيًا ضمن حصتك. عطّل الخيار للترجمة عند الطلب."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Переводить отсутствующий текст автоматически в пределах лимита. Отключите, чтобы переводить по запросу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жетіспейтін мәтінді лимитіңіз шегінде автоматты аудару. Сұрау бойынша аудару үшін өшіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Которулбаган текстти чегиңиздин ичинде автоматтык которуу. Сурам боюнча которуу үчүн өчүрүңүз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tarjima qilinmagan matnni limitingiz doirasida avtomatik tarjima qilish. So‘rov bo‘yicha tarjima uchun o‘chiring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Çevrilmemiş metni hakkınız dahilinde otomatik çevirir. İstek üzerine çevirmek için kapatın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjemahkan teks yang belum diterjemahkan secara otomatis sesuai kuota Anda. Nonaktifkan untuk menerjemahkan saat diminta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنی حد کے اندر غیر مترجم متن کا خودکار ترجمہ کریں۔ درخواست پر ترجمے کے لیے بند کریں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traduire automatiquement les textes manquants dans la limite de votre quota. Désactivez pour traduire sur demande."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traduce automáticamente el texto faltante dentro de tu cuota. Desactiva para traducir cuando lo solicites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traduz automaticamente o texto ausente dentro da sua cota. Desative para traduzir quando solicitar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafsiri maandishi ambayo hayajatafsiriwa kiotomatiki ndani ya kikomo chako. Zima ili kutafsiri unapoomba."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी सीमा के भीतर बिना अनुवाद वाले पाठ का अपने आप अनुवाद करें। अनुरोध पर अनुवाद के लिए बंद करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার সীমার মধ্যে অনূদিত নয় এমন লেখা স্বয়ংক্রিয়ভাবে অনুবাদ করুন। অনুরোধে অনুবাদ করতে বন্ধ করুন।"
          }
        }
      }
    },

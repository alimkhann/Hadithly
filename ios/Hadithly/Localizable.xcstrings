    "This translation was generated by AI (%@). It is not an authoritative rendering; verify important meanings against a qualified source.": {
      "comment": "A note at the bottom of the sheet explaining that the translation was generated by AI and that it should be verified against a qualified source.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This translation was generated by AI (%@). It is not an authoritative rendering; verify important meanings against a qualified source."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُنشئت هذه الترجمة بواسطة الذكاء الاصطناعي (%@). وليست ترجمة موثوقة؛ تحقّق من المعاني المهمة لدى مصدر مؤهل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот перевод создан ИИ (%@). Это не авторитетный перевод; проверяйте важный смысл по квалифицированному источнику."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бұл аударманы AI (%@) жасады. Бұл ресми аударма емес; маңызды мағыналарды білікті дереккөзбен тексеріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бул котормону AI (%@) түздү. Бул расмий котормо эмес; маанилүү мағыналарды квалификациялуу булак менен текшериңиз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu tarjima AI (%@) tomonidan yaratilgan. Bu vakolatli tarjima emas; muhim maʼnolarni malakali manba bilan tekshiring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu çeviri AI (%@) tarafından oluşturuldu. Yetkili bir çeviri değildir; önemli anlamları nitelikli bir kaynakla doğrulayın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Terjemahan ini dibuat oleh AI (%@). Ini bukan terjemahan resmi; verifikasi makna penting dengan sumber yang memenuhi syarat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "یہ ترجمہ AI (%@) نے بنایا ہے۔ یہ مستند ترجمہ نہیں؛ اہم معانی کو اہل ماخذ سے جانچیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette traduction a été générée par IA (%@). Ce n’est pas une version faisant autorité ; vérifiez les sens importants auprès d’une source qualifiée."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta traducción fue generada por IA (%@). No es una versión autorizada; verifica los significados importantes con una fuente cualificada."
          }

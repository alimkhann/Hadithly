    "Applies across the app. The reader previews each theme live.": {
      "comment": "A description of what the \"Appearance\" settings do.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Applies across the app. The reader previews each theme live."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينطبق على التطبيق كله. يعرض القارئ معاينة كل سمة مباشرة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Применяется ко всему приложению. В читалке каждая тема показывается в реальном времени."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бүкіл қолданбаға қолданылады. Оқырман әр тақырыпты тікелей алдын ала көрсетеді."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бүт колдонмого тиешелүү. Окугуч ар бир теманы түз көрсөтөт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Butun ilovaga qo‘llanadi. O‘quvchi har bir mavzuni jonli ko‘rsatadi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tüm uygulama için geçerlidir. Okuyucu her temayı canlı olarak önizler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berlaku di seluruh aplikasi. Pembaca menampilkan pratinjau langsung setiap tema."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "پوری ایپ پر لاگو ہوتا ہے۔ قاری ہر تھیم کا براہِ راست پیش منظر دکھاتا ہے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S’applique à toute l’application. La chitalka prévisualise chaque thème en direct."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se aplica a toda la app. El lector muestra una vista previa en vivo de cada tema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplica-se a todo o app. O leitor mostra cada tema ao vivo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hutumika kwenye programu yote. Msomaji huonyesha kila mandhari moja kwa moja."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पूरे ऐप पर लागू। रीडर हर थीम का लाइव पूर्वावलोकन दिखाता है।"
          }
        },

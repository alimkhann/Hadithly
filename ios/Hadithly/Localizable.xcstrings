    "la2.renewal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically at the displayed price for the selected billing period. Manage or cancel in your store account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتجدد تلقائيًا بالسعر المعروض للفترة المختارة. يمكنك الإدارة أو الإلغاء في حساب المتجر."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматическое продление по указанной цене за выбранный период. Управление и отмена в аккаунте магазина."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Таңдалған кезең үшін көрсетілген бағамен автоматты түрде жаңарады. Дүкен тіркелгісінде басқарыңыз не тоқтатыңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tanlangan davr uchun ko‘rsatilgan narxda avtomatik yangilanadi. Do‘kon hisobida boshqaring yoki bekor qiling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seçilen dönem için gösterilen fiyattan otomatik yenilenir. Mağaza hesabınızdan yönetin veya iptal edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diperpanjang otomatis dengan harga yang ditampilkan untuk periode terpilih. Kelola atau batalkan di akun toko Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "منتخب مدت کے لیے دکھائی گئی قیمت پر خودکار تجدید ہوتی ہے۔ اسٹور اکاؤنٹ میں انتظام یا منسوخی کریں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тандалган эсептешүү мезгили үчүн көрсөтүлгөн баада автоматтык түрдө жаңыланат. Дүкөн аккаунтуңуздан башкарыңыз же токтотуңуз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se renouvelle automatiquement au prix affiché pour la période choisie. Gérez ou annulez dans votre compte de boutique."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se renueva automáticamente al precio mostrado para el periodo elegido. Administra o cancela desde tu cuenta de la tienda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renova automaticamente pelo preço exibido para o período escolhido. Gerencie ou cancele na conta da loja."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hujisasisha kiotomatiki kwa bei iliyoonyeshwa kwa kipindi ulichochagua. Dhibiti au ghairi katika akaunti ya duka."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चुनी गई बिलिंग अवधि के लिए दिखाई गई कीमत पर अपने आप नवीनीकृत होता है। अपने स्टोर खाते में प्रबंधित या रद्द करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নির্বাচিত বিলিং সময়ের প্রদর্শিত মূল্যে স্বয়ংক্রিয়ভাবে নবায়ন হয়। স্টোর অ্যাকাউন্টে পরিচালনা বা বাতিল করুন।"
          }
        }
      }
    },
    "la2.checking": {
      "extractionState": "manual",
      "localizations": {

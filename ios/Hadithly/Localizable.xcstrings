    "la2.sample_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illustrative text by Hadithly, not a hadith. AI translations may contain errors."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص توضيحي من Hadithly، وليس حديثًا. قد تحتوي ترجمات الذكاء الاصطناعي على أخطاء."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример текста Hadithly, не хадис. Переводы ИИ могут содержать ошибки."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadithly мысал мәтіні, хадис емес. ЖИ аудармасында қате болуы мүмкін."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadithly misol matni, hadis emas. SI tarjimalarida xatolar bo‘lishi mumkin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadithly örnek metnidir, hadis değildir. Yapay zekâ çevirileri hata içerebilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks contoh oleh Hadithly, bukan hadis. Terjemahan AI dapat mengandung kesalahan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadithly کا مثالی متن، حدیث نہیں۔ AI ترجمے میں غلطیاں ہو سکتی ہیں۔"
          }
        },
        "ky": {
          "stringUnit": {

    "la2.welcome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read hadith in your language"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ الحديث بلغتك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читайте хадисы на своём языке"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадистерді өз тіліңізде оқыңыз"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadislarni o‘z tilingizda o‘qing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadisleri kendi dilinizde okuyun"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca hadis dalam bahasa Anda"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی زبان میں حدیث پڑھیں"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Хадистерди өз тилиңизде окуңуз"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisez les hadiths dans votre langue"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lee hadices en tu idioma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leia hadiths no seu idioma"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Soma hadithi kwa lugha yako"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी भाषा में हदीस पढ़ें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ভাষায় হাদিস পড়ুন"
          }
        }
      }
    },

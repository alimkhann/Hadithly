      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Пример сохраняет арабский оригинал. Источник: Hadithly. CC0 1.0."
        }
      },
      "kk": {
        "stringUnit": {
          "state": "translated",
          "value": "Мысалда арабша түпнұсқа сақталады. Дереккөз: Hadithly. CC0 1.0."
        }
      },
      "uz": {
        "stringUnit": {
          "state": "translated",
          "value": "Misolda arabcha asl matn saqlanadi. Manba: Hadithly. CC0 1.0."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu örnek Arapça kaynağı korur. Kaynak: Hadithly. CC0 1.0."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "Contoh ini mempertahankan sumber Arab. Sumber: Hadithly. CC0 1.0."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "یہ مثال عربی اصل متن محفوظ رکھتی ہے۔ ماخذ: Hadithly۔ CC0 1.0۔"
        }
      }
    }
  },

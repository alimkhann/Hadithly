    "q2.manage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage billing in the store where you purchased. Restore with your original Hadithly account. Pro works on your own iOS and Android devices; Family Sharing is off."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر الفوترة في المتجر الذي اشتريت منه. استعد مشترياتك باستخدام حساب Hadithly الأصلي. يعمل Pro على أجهزتك الخاصة بنظامي iOS وAndroid؛ المشاركة العائلية غير مفعّلة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بلنگ اسی اسٹور میں سنبھالیں جہاں خریداری کی تھی۔ بحالی کے لیے اپنا اصل Hadithly اکاؤنٹ استعمال کریں۔ Pro آپ کے اپنے iOS اور Android آلات پر کام کرتا ہے؛ فیملی شیئرنگ بند ہے۔"
          }
        },
        "ru": {

    },
    "Guests can read everything. An account just carries your bookmarks and notes across devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guests can read everything. An account just carries your bookmarks and notes across devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن للضيوف قراءة كل شيء. ينقل الحساب إشاراتك المرجعية وملاحظاتك بين الأجهزة فحسب."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Гости могут читать всё. Аккаунт нужен только для переноса закладок и заметок между устройствами."
          }
        },
        "kk": {
          "stringUnit": {

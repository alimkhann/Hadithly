    "Nothing here yet. While reading, use the menu bookmark or a hadith note.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nothing here yet. While reading, use the menu bookmark or a hadith note."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد شيء هنا بعد. أثناء القراءة، استخدم القائمة لوضع إشارة مرجعية على الحديث أو إضافة ملاحظة."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Здесь пока ничего нет. Во время чтения используйте меню, чтобы добавить закладку или заметку к хадису."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Мұнда әзірге ештеңе жоқ. Оқу кезінде хадисті сақтау немесе жазба қосу үшін мәзірді пайдаланыңыз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бул жерде азырынча эч нерсе жок. Окуп жатып хадисти сактоо же жазма кошуу үчүн менюну колдонуңуз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu yerda hali hech narsa yo‘q. O‘qish paytida hadisni saqlash yoki qayd qo‘shish uchun menyudan foydalaning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Burada henüz bir şey yok. Okurken hadisi kaydetmek veya not eklemek için menüyü kullanın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Belum ada apa pun di sini. Saat membaca, gunakan menu untuk menyimpan hadis atau menambahkan catatan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابھی یہاں کچھ نہیں۔ مطالعے کے دوران حدیث محفوظ کرنے یا نوٹ شامل کرنے کے لیے مینو استعمال کریں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien ici pour le moment. Pendant la lecture, utilisez le menu pour ajouter un signet ou une note au hadith."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todavía no hay nada aquí. Mientras lees, usa el menú para guardar el hadiz o añadir una nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ainda não há nada aqui. Durante a leitura, use o menu para salvar o hadith ou adicionar uma nota."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hakuna kitu hapa bado. Unaposoma, tumia menyu kuhifadhi hadithi au kuongeza dokezo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अभी यहाँ कुछ नहीं है। पढ़ते समय हदीस को बुकमार्क करें या नोट जोड़ने के लिए मेनू का उपयोग करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখানে এখনও কিছু নেই। পড়ার সময় হাদিস বুকমার্ক করতে বা নোট যোগ করতে মেনু ব্যবহার করুন।"
          }
        }
      }
    },

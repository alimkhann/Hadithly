  "la2.allowance": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "5 free or 100 Pro new translations in a rolling 7 days. Approved and cached translations stay free."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "5 ترجمات جديدة مجانًا أو 100 مع Pro خلال آخر 7 أيام. الترجمات المعتمدة والمخزنة تبقى مجانية."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "5 новых переводов бесплатно или 100 с Pro за скользящие 7 дней. Готовые и одобренные переводы бесплатны."
        }
      },
      "kk": {
        "stringUnit": {
          "state": "translated",
          "value": "Соңғы 7 күнде 5 тегін немесе Pro-мен 100 жаңа аударма. Бекітілген және сақталған аудармалар тегін."
        }
      },
      "uz": {
        "stringUnit": {
          "state": "translated",
          "value": "Oxirgi 7 kunda 5 bepul yoki Pro bilan 100 yangi tarjima. Tasdiqlangan va saqlangan tarjimalar bepul."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Son 7 günde ücretsiz 5 veya Pro ile 100 yeni çeviri. Onaylı ve önbellekteki çeviriler ücretsizdir."
        }
      },
      "id": {
        "stringUnit": {
          "state": "translated",
          "value": "5 terjemahan baru gratis atau 100 dengan Pro dalam 7 hari berjalan. Terjemahan yang disetujui dan tersimpan tetap gratis."
        }
      },
      "ur": {
        "stringUnit": {
          "state": "translated",
          "value": "گزشتہ مسلسل 7 دنوں میں 5 مفت یا Pro کے ساتھ 100 نئے ترجمے۔ منظور شدہ اور محفوظ ترجمے مفت رہتے ہیں۔"
        }
      }
    }
  },

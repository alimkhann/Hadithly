    "Processing evidence. Your suggestion stays private and has not been reviewed or published." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تجري معالجة الأدلة. يظل اقتراحك خاصًا ولم تتم مراجعته أو نشره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রমাণ প্রক্রিয়াকরণ হচ্ছে। আপনার প্রস্তাব ব্যক্তিগত থাকে এবং এখনো পর্যালোচনা বা প্রকাশ করা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Processing evidence. Your suggestion stays private and has not been reviewed or published."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Procesando la evidencia. Tu propuesta sigue siendo privada y aún no se ha revisado ni publicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Traitement des pièces justificatives. Votre proposition reste privée et n’a pas encore été examinée ni publiée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "साक्ष्य पर प्रक्रिया हो रही है। आपका सुझाव निजी रहता है और अभी उसकी समीक्षा या प्रकाशन नहीं हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bukti sedang diproses. Usulan Anda tetap pribadi dan belum ditinjau atau diterbitkan."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дәлелдер өңделуде. Ұсынысыңыз жеке күйінде қалады, ол әлі қаралған немесе жарияланған жоқ."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Далилдер иштетилүүдө. Сунушуңуз купуя бойдон калат, ал азырынча карала же жарыялана элек."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Processando as evidências. Sua sugestão continua privada e ainda não foi revisada nem publicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Доказательства обрабатываются. Ваше предложение остаётся закрытым; оно ещё не проверено и не опубликовано."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ushahidi unachakatwa. Pendekezo lako linabaki la faragha na bado halijapitiwa wala kuchapishwa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanıtlar işleniyor. Öneriniz gizli kalır; henüz incelenmedi veya yayımlanmadı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ثبوت پر کارروائی ہو رہی ہے۔ آپ کی تجویز نجی رہتی ہے اور ابھی اس کا جائزہ نہیں لیا گیا یا اسے شائع نہیں کیا گیا۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dalillar qayta ishlanmoqda. Taklifingiz maxfiy qoladi; u hali ko‘rib chiqilmagan yoki e’lon qilinmagan."
          }
        }
      }
    },
    "Retry evidence" : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إعادة محاولة معالجة الأدلة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রমাণ প্রক্রিয়াকরণ আবার চেষ্টা করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Retry evidence"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reintentar el procesamiento de la evidencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réessayer le traitement des pièces"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "साक्ष्य पर प्रक्रिया फिर से आज़माएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coba proses bukti lagi"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дәлелдерді өңдеуді қайталау"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Далилдерди иштетүүнү кайталоо"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tentar processar as evidências novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повторить обработку доказательств"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jaribu kuchakata ushahidi tena"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanıt işlemeyi yeniden dene"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ثبوت پر کارروائی دوبارہ آزمائیں"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dalillarni qayta ishlashni takrorlash"
          }
        }
      }
    },
    "Sign in from Settings to suggest a translation with evidence." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سجّل الدخول من الإعدادات لاقتراح ترجمة مع أدلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রমাণসহ অনুবাদ প্রস্তাব করতে সেটিংস থেকে সাইন ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sign in from Settings to suggest a translation with evidence."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia sesión desde Configuración para proponer una traducción con evidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous dans les Réglages pour proposer une traduction avec des pièces justificatives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "साक्ष्य के साथ अनुवाद सुझाने के लिए सेटिंग्स से साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masuk dari Pengaturan untuk mengusulkan terjemahan dengan bukti."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дәлелмен бірге аударма ұсыну үшін Баптаулардан аккаунтқа кіріңіз."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Далилдер менен котормо сунуштоо үчүн Жөндөөлөрдөн аккаунтка кириңиз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre pela seção Configurações para sugerir uma tradução com evidências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Войдите в аккаунт в Настройках, чтобы предложить перевод с доказательствами."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingia kupitia Mipangilio ili kupendekeza tafsiri yenye ushahidi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kanıtlarla çeviri önermek için Ayarlar’dan oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ثبوت کے ساتھ ترجمہ تجویز کرنے کے لیے ترتیبات سے سائن اِن کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dalillar bilan tarjima taklif qilish uchun Sozlamalardan hisobga kiring."
          }
        }
      }
    },
    "The private files were removed before processing. You can start a new suggestion." : {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أُزيلت الملفات الخاصة قبل معالجتها. يمكنك بدء اقتراح جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "প্রক্রিয়াকরণের আগে ব্যক্তিগত ফাইলগুলো সরানো হয়েছে। আপনি নতুন প্রস্তাব শুরু করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The private files were removed before processing. You can start a new suggestion."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los archivos privados se eliminaron antes de procesarlos. Puedes iniciar una nueva propuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fichiers privés ont été supprimés avant leur traitement. Vous pouvez commencer une nouvelle proposition."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "निजी फ़ाइलें प्रक्रिया शुरू होने से पहले हटा दी गई थीं। आप नया सुझाव शुरू कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berkas pribadi dihapus sebelum diproses. Anda dapat memulai usulan baru."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жеке файлдар өңдеуге дейін жойылды. Жаңа ұсыныс бастауға болады."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жеке файлдар иштетүүгө чейин өчүрүлдү. Жаңы сунуш баштасаңыз болот."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os arquivos privados foram removidos antes do processamento. Você pode iniciar uma nova sugestão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Закрытые файлы были удалены до обработки. Вы можете начать новое предложение."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faili za faragha ziliondolewa kabla ya kuchakatwa. Unaweza kuanza pendekezo jipya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Özel dosyalar işlenmeden önce kaldırıldı. Yeni bir öneri başlatabilirsiniz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "نجی فائلیں کارروائی سے پہلے ہٹا دی گئیں۔ آپ نئی تجویز شروع کر سکتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maxfiy fayllar qayta ishlanishidan oldin o‘chirildi. Yangi taklif boshlashingiz mumkin."
          }
        }
      }
    },
    "Withdraw suggestion" : {
      "localizations": {

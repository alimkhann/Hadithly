    "e3.consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By submitting, you allow Hadithly to review and publish your suggestion. Evidence sources still require permission."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بإرسال اقتراحك، تسمح لـ Hadithly بمراجعته ونشره. ولا تزال مصادر الأدلة تتطلب إذنًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تجویز بھیج کر آپ Hadithly کو اس کا جائزہ لینے اور شائع کرنے کی اجازت دیتے ہیں۔ ثبوت کے ذرائع کے لیے پھر بھی اجازت درکار ہے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отправляя предложение, вы разрешаете Hadithly проверить и опубликовать его. Для источников доказательств по-прежнему требуется разрешение."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ұсынысты жіберу арқылы Hadithly-ге оны тексеруге және жариялауға рұқсат бересіз. Дәлел дереккөздеріне бәрібір рұқсат қажет."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Жөнөтүү менен Hadithly’ге сунушуңузду текшерүүгө жана жарыялоого уруксат бересиз. Далил булактарына дагы уруксат керек."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taklif yuborish orqali Hadithly’ga uni tekshirish va nashr qilishga ruxsat berasiz. Dalil manbalari uchun baribir ruxsat kerak."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Göndererek Hadithly’nin önerinizi incelemesine ve yayımlamasına izin verirsiniz. Kanıt kaynakları için yine de izin gerekir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dengan mengirimkan usulan, Anda mengizinkan Hadithly memeriksa dan menerbitkannya. Sumber bukti tetap memerlukan izin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En envoyant votre proposition, vous autorisez Hadithly à la vérifier et à la publier. Les sources des preuves nécessitent toujours une autorisation."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al enviar la propuesta, permites que Hadithly la revise y publique. Las fuentes de las pruebas aún requieren permiso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ao enviar, você permite que a Hadithly revise e publique sua sugestão. As fontes das evidências ainda precisam de permissão."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kwa kuwasilisha, unaruhusu Hadithly kukagua na kuchapisha pendekezo lako. Vyanzo vya ushahidi bado vinahitaji ruhusa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सबमिट करके आप Hadithly को अपने सुझाव की समीक्षा और प्रकाशन की अनुमति देते हैं। साक्ष्य स्रोतों के लिए अब भी अनुमति चाहिए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "জমা দিয়ে আপনি Hadithly-কে আপনার প্রস্তাব পর্যালোচনা ও প্রকাশের অনুমতি দেন। প্রমাণের উৎসের জন্য এখনও অনুমতি দরকার।"
          }
        }
      }
    },

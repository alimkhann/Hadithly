    "e4.appeal_window": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can request one automatic appeal within 30 days. It does not extend evidence retention."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن طلب استئناف آلي واحد خلال 30 يومًا. لا يمدد مدة الاحتفاظ بالأدلة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ 30 دن کے اندر ایک خودکار اپیل کی درخواست کر سکتے ہیں۔ اس سے شواہد رکھنے کی مدت نہیں بڑھتی۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы можете запросить одну автоматическую апелляцию в течение 30 дней. Это не продлевает срок хранения доказательств."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 күн ішінде бір автоматты апелляция сұрай аласыз. Бұл дәлелдерді сақтау мерзімін ұзартпайды."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 күндүн ичинде бир автоматтык апелляция сурасаңыз болот. Бул далилдерди сактоо мөөнөтүн узартпайт."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 kun ichida bitta avtomatik apellyatsiya so‘rashingiz mumkin. Bu dalillarni saqlash muddatini uzaytirmaydi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "30 gün içinde bir otomatik itiraz isteyebilirsiniz. Bu, kanıt saklama süresini uzatmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda dapat meminta satu banding otomatis dalam 30 hari. Ini tidak memperpanjang penyimpanan bukti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez demander un recours automatique dans les 30 jours. Il ne prolonge pas la conservation des preuves."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes solicitar una apelación automática en un plazo de 30 días. No amplía la retención de pruebas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode solicitar uma apelação automática em até 30 dias. Ela não prolonga a retenção das evidências."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unaweza kuomba rufaa moja ya kiotomatiki ndani ya siku 30. Haiongezi muda wa kuhifadhi ushahidi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आप 30 दिनों के भीतर एक स्वचालित अपील का अनुरोध कर सकते हैं। इससे साक्ष्य रखने की अवधि नहीं बढ़ती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "৩০ দিনের মধ্যে একটি স্বয়ংক্রিয় আপিলের অনুরোধ করতে পারেন। এতে প্রমাণ সংরক্ষণের সময় বাড়ে না।"
          }
        }
      }
    },

    "la2.account_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to keep your saved hadiths and notes with you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سجّل الدخول لتبقى أحاديثك المحفوظة وملاحظاتك معك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Войдите, чтобы сохранённые хадисы и заметки были с вами."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сақталған хадистер мен жазбалар өзіңізбен бірге болуы үшін кіріңіз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saqlangan hadislar va qaydlaringiz siz bilan bo‘lishi uchun kiring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaydettiğiniz hadisler ve notlarınız yanınızda olsun diye giriş yapın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Masuk agar hadis tersimpan dan catatan Anda selalu bersama Anda."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اپنی محفوظ احادیث اور نوٹس ساتھ رکھنے کے لیے سائن ان کریں۔"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сакталган хадистер менен жазууларыңыз жаныңызда болушу үчүн кириңиз."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connectez-vous pour retrouver vos hadiths enregistrés et vos notes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia sesión para llevar contigo tus hadices guardados y notas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre para ter seus hadiths salvos e suas notas sempre com você."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingia ili uwe na hadithi ulizohifadhi na madokezo yako popote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपनी सहेजी गई हदीसें और नोट्स साथ रखने के लिए साइन इन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সংরক্ষিত হাদিস ও নোট সঙ্গে রাখতে সাইন ইন করুন।"

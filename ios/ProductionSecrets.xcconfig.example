// Copy to ProductionSecrets.xcconfig before creating an archive.
// These are public client keys, but keeping environment-specific values out of
// source control prevents accidental dev/prod mixups.
CLERK_PUBLISHABLE_KEY = pk_live_your_production_key
REVENUECAT_API_KEY = appl_your_production_public_sdk_key
PRIVACY_POLICY_URL = https:/$()/your-public-site.example/privacy
TERMS_OF_USE_URL = https:/$()/your-public-site.example/terms

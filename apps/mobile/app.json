{
  "expo": {
    "name": "Hadithly",
    "slug": "hadithly",
    "scheme": "hadithly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/hadithly-logo-light.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hadithly.app",
      "appleTeamId": "6378AFQPXV"
    },
    "android": {
      "package": "com.hadithly.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/hadithly-logo-dark.png",
        "backgroundColor": "#18181B"
      }
    },
    "plugins": [
      "@clerk/expo",
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/hadithly-logo-light.png",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/brand/hadithly-logo-dark.png",
            "backgroundColor": "#18181B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

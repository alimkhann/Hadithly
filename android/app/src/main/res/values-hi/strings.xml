    <string name="e3_published_message" formatted="false">आपका अनुवाद अब रीडर में उपलब्ध है। आपके योगदान की स्थिति निजी रहती है।</string>
    <string name="e3_exception_message" formatted="false">स्रोत की अनुमतियों या सहायक साक्ष्यों की दोबारा जाँच होने तक आपका सुझाव निजी रहेगा।</string>
    <string name="e3_rejected_message" formatted="false">जाँचों ने प्रकाशन का समर्थन नहीं किया। आपका सुझाव निजी रहेगा।</string>
    <string name="e3_unavailable_message" formatted="false">आपका सुझाव निजी रहेगा। ज़रूरत हो तो इसे वापस लेकर बाद में फिर कोशिश करें।</string>
    <string name="e3_waiting" formatted="false">समीक्षा की प्रतीक्षा करते हुए आपका सुझाव निजी रहेगा।</string>
    <string name="e3_sources">Sources</string>
    <string name="e3_consent" formatted="false">सबमिट करके आप Hadithly को अपने सुझाव की समीक्षा और प्रकाशन की अनुमति देते हैं। साक्ष्य स्रोतों के लिए अब भी अनुमति चाहिए।</string>
    <string name="e3_translation_sources">Translation sources</string>
    <string name="e3_community_sources_message" formatted="false">एक योगदानकर्ता ने यह अनुवाद सुझाया। स्वचालित जाँचों ने इसे उद्धृत साक्ष्य से मिलाया। यह प्रामाणिक अनुवाद नहीं है।</string>

    <string name="native_e21f935f11d7">Nusxalash</string>
    <string name="native_004e9ce2b80f">Ma’no, so‘z tanlovi yoki nisbat berish bo‘yicha xavotirni tasvirlang. Hisobotlar maxfiy va ovoz yoki reyting emas.</string>
    <string name="native_00cb857374a6">Foydalanuvchi nomini saqlash</string>

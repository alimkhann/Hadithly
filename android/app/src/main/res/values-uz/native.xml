    <string name="native_18a0c098c7fb">TAHRIRLASH</string>
    <string name="native_21d749165449">Avatar kirish usulingizga qarab belgilanadi.</string>
    <string name="native_3740fd6cbdff">Bu to‘plamni ochib bo‘lmadi</string>
    <string name="native_3ea7835d6d78">Ushbu qurilmada kunlik hadisni olish uchun kiring</string>
    <string name="native_48f0d3d397d4">Chiqish</string>
    <string name="native_4f543e452064">Hadithly Pro faol</string>
    <string name="native_50deba1f29ea">Obunangizni ko‘rish uchun kiring. Xaridlaringiz barcha qurilmalarda Hadithly hisobingizga bog‘langan bo‘ladi.</string>
    <string name="native_5457393ebfcc">Inglizcha tarjima hali mavjud emas.</string>
    <string name="native_58d330f27985">Yetti asosiy hadis to‘plami uchun sokin o‘quvchi. Arabcha matn manbalaridan litsenziyalangan; SI tarjimalari doim belgilanadi.</string>
    <string name="native_61c2709f9d99">SI tarjimasi mavjud emas · qayta urinish</string>
    <string name="native_6a77e7691626">Hisobot maxfiy yuborildi</string>
    <string name="native_6c6e178ad2a8">Parollar mos kelmaydi.</string>
    <string name="native_6ef998ee12f7">Yaroqli hadis hali keshga saqlanmagan</string>
    <string name="native_7175517a370b">yoki</string>
    <string name="native_71c7158ec4ea">Kamida bitta matn qatlami ko‘rinib turishi kerak.</string>
    <string name="native_82095f5cb9a4">Kutubxonada to‘plamni oching, Bugun esa tasdiqlangan mazmundan birini tayyorlaydi.</string>
    <string name="native_8809dd9048f8">Bugungi hadisni yuklab bo‘lmadi</string>
    <string name="native_8e3a83b3d254">Bu amalni yuqoridagi xabardan bekor qilishingiz mumkin.</string>
    <string name="native_a1794783aab7">Oflayn</string>
    <string name="native_a4194ff09706">Bugungi hadis olinmoqda…</string>
    <string name="native_b5a1c683ff49">Tilingiz uchun asosiy arab fayllari va tarjima paketi. Har bir fayl faollashtirilishidan oldin nazorat yig‘indisi va litsenziyasi tekshiriladi. Almashtirish va saqlangan joylaringiz tekshirilguncha oldingi nusxa o‘qilishi mumkin.</string>
    <string name="native_b7297226fd1f">Ismni saqlash</string>
    <string name="native_b7d74756ff3b">Tozalash xatcho‘plar, sevimlilar, qaydlar, o‘qish jarayoni yoki yuklangan to‘plamlarni hech qachon o‘chirmaydi.</string>
    <string name="native_d96ad3ca286c">Hadithly qurilmasining umumiy xotirasini tizim sozlamalari sahifasida ko‘ring.</string>
    <string name="native_e3b89e9d33f8">Foydalanuvchi nomi</string>
    <string name="native_e820440bb043">Mehmon sifatida o‘qish</string>
    <string name="native_ec0c8dea1a19">Vaqtinchalik kesh</string>
    <string name="native_ec963ffc911b">Tekshirilmoqda…</string>
    <string name="native_ee5ef73aae18">Maʼlumotlaringiz</string>
    <string name="native_f5a77522b1ba">Oflayn to‘plamlar</string>
    <string name="native_fa8a45b3662d">O‘qish uchun kerak bo‘lgan hamma narsa hisobsiz ishlaydi. Xatcho‘p, sevimli va qaydlarni qurilmalar o‘rtasida olib yurish uchun kiring.</string>
    <string name="native_ff6c3270c09d">Butun ilovaga qo‘llanadi. O‘quvchi har bir mavzuni jonli ko‘rsatadi.</string>
